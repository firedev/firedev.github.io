<!doctype html>
<html lang="en">
<head>
  {%@ "head" %}
</head>
<body class="{{ data.page_class }} min-h-screen overflow-x-hidden">
  {% current_path = resource.relative_url %}
  {% posts_active = current_path.start_with?("/posts") || data.page_class == "archive-page" %}
  <header class="site-header mx-auto flex w-[min(1180px,calc(100%-2rem))] flex-col gap-5 border-b border-line py-5 md:flex-row md:items-center md:gap-8 md:py-6">
    <a href="/" class="block w-44 shrink-0 md:w-52 lg:w-56" aria-label="firedev.com home">
      <img src="/images/logos/firedev.svg" alt="firedev.com" class="h-auto w-full">
    </a>
    <nav class="site-nav flex w-full flex-wrap items-center gap-x-6 gap-y-2 text-lg font-black md:flex-1 md:flex-nowrap md:gap-x-8 md:text-[1.35rem]" aria-label="Primary">
      <a href="/posts/" class="nav-link inline-flex min-h-11 items-center {{ posts_active ? 'is-active text-fire' : 'text-muted' }}" {% if posts_active %}aria-current="page"{% end %}>Posts</a>
      <a href="/projects/" class="nav-link inline-flex min-h-11 items-center {{ current_path.start_with?('/projects') ? 'is-active text-fire' : 'text-muted' }}" {% if current_path.start_with?('/projects') %}aria-current="page"{% end %}>Projects</a>
      <a href="/about/" class="nav-link inline-flex min-h-11 items-center {{ current_path.start_with?('/about') ? 'is-active text-fire' : 'text-muted' }}" {% if current_path.start_with?('/about') %}aria-current="page"{% end %}>About</a>
      <a href="mailto:nick@firedev.com" class="nav-cta inline-flex min-h-11 items-center justify-center border border-ink px-4 py-3 text-base font-black text-ink md:ml-auto md:px-5">Email ↗</a>
    </nav>
  </header>

  <main>
    {%= yield %}
  </main>

  <footer class="mx-auto mt-20 flex w-[min(1180px,calc(100%-2rem))] justify-between gap-8 border-t border-line py-8 text-sm text-muted">
    <span>© Nikolay Ostrovsky</span>
    <span>Phuket · Thailand</span>
  </footer>
</body>
</html>
