<!doctype html>
<html lang="en">
<head>
  {%@ "head" %}
</head>
<body class="{{ data.page_class }} min-h-screen overflow-x-hidden">
  <header class="mx-auto flex min-h-28 w-[min(1180px,calc(100%-2rem))] flex-col items-start gap-5 border-b border-line py-6 md:flex-row md:items-end md:gap-10 md:py-8">
    <a href="/" class="block w-48 shrink-0 md:w-56 lg:w-64" aria-label="firedev.com home">
      <img src="/images/logos/firedev.svg" alt="firedev.com" class="h-auto w-full">
    </a>
    <nav class="flex w-full flex-wrap items-center gap-x-5 gap-y-3 text-base font-black md:flex-1 md:gap-x-10 md:text-xl" aria-label="Primary">
      <a href="/posts/" class="text-muted hover:text-fire">Posts</a>
      <a href="/projects/" class="text-muted hover:text-fire">Projects</a>
      <a href="/about/" class="text-muted hover:text-fire">About</a>
      <a href="mailto:nick@firedev.com" class="w-full border border-ink px-4 py-3 text-center text-ink hover:border-fire hover:bg-fire hover:text-white md:ml-auto md:w-auto">Let’s work together ↗</a>
    </nav>
  </header>

  <main>
    {%= yield %}
  </main>

  <footer class="mx-auto mt-20 flex w-[min(1180px,calc(100%-2rem))] justify-between gap-8 border-t border-line py-8 text-sm text-muted">
    <span>© Nikolay Ostrovsky</span>
    <span>Phuket · Thailand</span>
  </footer>
</body>
</html>
