<!doctype html>
<html lang="en">
<head>
  {%@ "head" %}
</head>
<body class="{{ data.page_class }} min-h-screen overflow-x-hidden">
  <header class="mx-auto flex min-h-24 w-[min(1180px,calc(100%-2rem))] flex-col items-start gap-4 border-b border-line py-5 md:flex-row md:items-end md:gap-8 md:py-6">
    <a href="/" class="block w-40 shrink-0 md:w-48" aria-label="firedev.com home">
      <img src="/images/logos/firedev.svg" alt="firedev.com" class="h-auto w-full">
    </a>
    <nav class="flex w-full flex-wrap items-center gap-x-4 gap-y-3 text-sm font-bold md:flex-1 md:gap-x-8" aria-label="Primary">
      <a href="/posts/" class="text-muted hover:text-fire">Posts</a>
      <a href="/projects/" class="text-muted hover:text-fire">Projects</a>
      <a href="/about/" class="text-muted hover:text-fire">About</a>
      <a href="mailto:nick@firedev.com" class="w-full text-ink hover:text-fire md:ml-auto md:w-auto">Let’s work together ↗</a>
    </nav>
  </header>

  <main>
    {%= yield %}
  </main>

  <footer class="mx-auto mt-20 flex w-[min(1180px,calc(100%-2rem))] justify-between gap-8 border-t border-line py-8 text-sm text-muted">
    <span>© Nikolay Ostrovsky</span>
    <span>Phuket · Thailand</span>
  </footer>
</body>
</html>
